      "patch": "@@ -8,7 +8,7 @@\n     <parent>\n         <groupId>org.springframework.boot</groupId>\n         <artifactId>spring-boot-starter-parent</artifactId>\n-        <version>2.7.0</version>\n+        <version>3.5.15</version>\n         <relativePath/>\n     </parent>\n \n@@ -19,11 +19,9 @@\n     <description>Task Management API - Cobaye DevSecOps Platform</description>\n \n     <properties>\n-        <java.version>11</java.version>\n-        <lombok.version>1.18.32</lombok.version>\n+        <java.version>17</java.version>\n+        <tomcat.version>10.1.59</tomcat.version>\n         <!-- Versions vuln\u00e9rables intentionnelles -->\n-        <logback.version>1.2.11</logback.version>\n-        <snakeyaml.version>1.29</snakeyaml.version>\n     </properties>\n \n     <dependencies>\n@@ -37,7 +35,6 @@\n         <dependency>\n             <groupId>org.springframework.security</groupId>\n             <artifactId>spring-security-core</artifactId>\n-            <version>5.6.4</version>\n         </dependency>\n         <dependency>\n             <groupId>org.springframework.boot</groupId>\n@@ -61,14 +58,12 @@\n         <dependency>\n             <groupId>ch.qos.logback</groupId>\n             <artifactId>logback-classic</artifactId>\n-            <version>1.2.11</version>\n         </dependency>\n \n         <!-- SnakeYAML 1.29 \u2014 CVE-2022-25857 HIGH -->\n         <dependency>\n             <groupId>org.yaml</groupId>\n             <artifactId>snakeyaml</artifactId>\n-            <version>1.29</version>\n         </dependency>\n \n         <!-- JWT -->\n@@ -78,6 +73,13 @@\n             <version>0.9.1</version>\n         </dependency>\n \n+        <!-- JJWT 0.9.1 uses DatatypeConverter, removed from JDK 11+. -->\n+        <dependency>\n+            <groupId>javax.xml.bind</groupId>\n+            <artifactId>jaxb-api</artifactId>\n+            <version>2.3.1</version>\n+        </dependency>\n+\n         <!-- Lombok -->\n         <dependency>\n             <groupId>org.projectlombok</groupId>\n@@ -108,7 +110,6 @@\n         <dependency>\n             <groupId>org.springframework.security</groupId>\n             <artifactId>spring-security-test</artifactId>\n-            <version>5.6.4</version>\n             <scope>test</scope>\n         </dependency>\n     </dependencies>"
