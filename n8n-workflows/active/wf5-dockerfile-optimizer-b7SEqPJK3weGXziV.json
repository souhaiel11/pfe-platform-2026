    {
      "parameters": {
        "jsCode": "const gh = $input.first().json;\nlet decoded = '';\nif (typeof gh.content === 'string' && gh.encoding === 'base64') {\n  try { decoded = Buffer.from(gh.content.replace(/\\n/g,''), 'base64').toString('utf-8'); } catch(e) {}\n} else if (typeof gh.content === 'string') {\n  decoded = gh.content;                          // déjà décodé par le node n8n\n} else if (typeof gh.data === 'string') {\n  decoded = gh.data;\n}\nif (!decoded || decoded.length < 10) {\n  return [{ json: { success:false, error:'EMPTY_FILE', message:'Dockerfile vide ou introuvable — collez-le manuellement' } }];\n}\nreturn [{ json: { success:true, content:decoded, filePath:$('Prepare - Fetch Body').first().json.filePath, sha:gh.sha||'', source:'github' } }];\n"
      },
      "id": "553d8e26-78ac-423c-acd5-5f62243e47c7",
