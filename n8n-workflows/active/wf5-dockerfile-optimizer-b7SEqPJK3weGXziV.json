        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst owner = String(body.owner || '').trim();\nconst repo  = String(body.repo  || '').trim();\nconst filePath = String(body.filePath || 'Dockerfile').trim();\nconst ref = String(body.ref || 'main').trim();\nif (!owner || !repo) return [{ json: { error:'INVALID_INPUT', message:'owner et repo sont requis' } }];\nreturn [{ json: { owner, repo, filePath, ref } }];\n"
      },
