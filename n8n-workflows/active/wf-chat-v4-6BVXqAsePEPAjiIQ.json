      "parameters": {
        "jsCode": "// Récupère la question, le projectId et l'historique\nconst question = $input.first().json.body.question;\nconst projectId = $input.first().json.body.projectId;\nconst history = $input.first().json.body.history || [];\n\nreturn [{\n  json: {\n    question: question,\n    projectId: projectId,\n    history: history\n  }\n}];"
      },
