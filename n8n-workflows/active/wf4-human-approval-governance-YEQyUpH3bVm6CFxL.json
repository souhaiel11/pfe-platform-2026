    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst incidentId = item.json.incidentId;\nconst repository = item.json.repository;\nconst prNumber = item.json.prNumber;\nconst final_summary = item.json.final_summary;\nconst final_risk_level = item.json.final_risk_level;\nconst selected_action = item.json.selected_action;\nconst confidence_score = item.json.confidence_score;\nconst files_touched = item.json.files_touched;\n\nreturn [{\n  json: {\n    incidentId,\n    repository,\n    prNumber,\n    final_summary,\n    final_risk_level,\n    selected_action,\n    confidence_score,\n    files_touched,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "999dd355-cf6c-4312-a281-71b029f87d92",
      "name": "Prepare Approval Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1120,
        96
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_BASE_URL }}/api/approvals",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "86d0977d-69fa-4228-809a-edcabe520652",
