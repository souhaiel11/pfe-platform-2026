      "typeVersion": 4.4,
      "position": [
        -896,
        96
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "sendTo": "={{ $env.APPROVAL_EMAIL }}",
        "subject": "=Approval Required: AI Remediation {{ $json.incidentId }}",
        "message": "=<h2>AI Remediation Approval Request</h2>\n\n<p><strong>Incident ID:</strong> {{ $json.incidentId }}</p>\n<p><strong>Repository:</strong> {{ $json.repository }}</p>\n<p><strong>Pull Request:</strong> #{{ $json.prNumber }}</p>\n<p><strong>Risk Level:</strong> {{ $json.final_risk_level }}</p>\n<p><strong>Confidence Score:</strong> {{ $json.confidence_score }}</p>\n\n<h3>Summary</h3>\n<p>{{ $json.final_summary }}</p>\n\n<h3>Selected Action</h3>\n<p>{{ $json.selected_action }}</p>\n\n<h3>Files Touched</h3>\n<p>{{ $json.files_touched }}</p>\n\n<hr>\n<p><strong>Please review and approve or reject this remediation.</strong></p>\n<p>Click the approval link sent separately or respond via the approval system.</p>",
        "options": {
          "bccList": "",
          "ccList": ""
        }
      },
      "id": "49fb8955-cbce-4cd1-bbb8-09432bcae995",
      "name": "Send Approval Request",
