<?xml version="1.0" encoding="UTF-8"?>
<!-- ════════════════════════════════════════════════════════════════════════════
     PROJET DE VALIDATION VERMEG
     APPLICATION INTENTIONNELLEMENT VULNÉRABLE — BANC D'ESSAI UNIQUEMENT.
     Ne jamais déployer hors d'un environnement de test isolé.

     Ce descripteur est volontairement SANS DÉFAUT : il doit fonctionner
     parfaitement, car c'est lui que la chaîne de remédiation va modifier.
     Les défauts du projet sont ailleurs — dans les versions de dépendances,
     dans le Dockerfile, dans le Jenkinsfile et dans le code source.

     Aucun parent : un parent introduirait une gestion de version par BOM,
     c'est-à-dire exactement la provenance que la plateforme refuse
     d'auto-corriger (BOM_MANAGED → ADMIN_ACTION_REQUIRED).
     Un seul pom, à la racine : l'adaptateur de cible de la plateforme
     n'ancre que le descripteur racine, jamais un module enfant.
     Voir docs/MATRICE_VALIDATION.md.
     ════════════════════════════════════════════════════════════════════════ -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>tn.vermeg.validation</groupId>
  <artifactId>projet-validation-vermeg</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>projet-validation-vermeg</name>
  <description>PROJET DE VALIDATION INTENTIONNELLEMENT VULNERABLE — BANC D'ESSAI UNIQUEMENT</description>

  <properties>
    <!-- 17 est la seule valeur qui passe des deux côtés : le vérificateur de
         candidats compile en JDK 17, Jenkins en JDK 21. -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-10-19T00:00:00Z</project.build.outputTimestamp>

    <!-- Chemin du rapport JaCoCo, lu par le scanner Sonar. Sans cette propriété,
         Sonar affiche 0 % de couverture : exact, mais trompeur. -->
    <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

    <!-- ╔══════════════════════════════════════════════════════════════════╗
         ║ VAL-D02 — dépendance gérée par PROPRIÉTÉ LOCALE                  ║
         ║ Provenance PROPERTY_MANAGED : la plateforme doit corriger CETTE  ║
         ║ propriété, pas une version écrite en dur dans <dependency>.      ║
         ╚══════════════════════════════════════════════════════════════════╝ -->
    <commons-lang3.version>3.12.0</commons-lang3.version>
  </properties>

  <dependencies>

    <!-- ╔══════════════════════════════════════════════════════════════════╗
         ║ VAL-D01 — AUTO-CORRIGEABLE · provenance DIRECT_EXPLICIT          ║
         ║ h2 2.1.212 porte CVE-2022-45868 (HIGH), corrigée en 2.2.220.     ║
         ║ Même majeure (2.x) → dans l'enveloppe auto-corrigeable.          ║
         ║ Usage authentique : la valorisation du portefeuille est calculée ║
         ║ par agrégation SQL en mémoire (ValorisationPortefeuille).        ║
         ║ Périmètre de sûreté : base strictement en mémoire, aucune        ║
         ║ console H2, aucune URL fournie par l'appelant, requêtes          ║
         ║ préparées uniquement, aucun SQL construit depuis une entrée.     ║
         ╚══════════════════════════════════════════════════════════════════╝ -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.1.212</version>
    </dependency>

    <!-- VAL-D02 — pilotée par ${commons-lang3.version} déclarée ci-dessus.
         3.12.0 porte CVE-2025-48924 (MEDIUM), corrigée en 3.18.0, même majeure. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>${commons-lang3.version}</version>
    </dependency>

    <!-- ╔══════════════════════════════════════════════════════════════════╗
         ║ VAL-D03 — AUTO-CORRIGEABLE · provenance DIRECT_EXPLICIT          ║
         ║ commons-io 2.6 porte CVE-2021-29425 (traversée de chemin),       ║
         ║ corrigée en 2.7 — même majeure.                                  ║
         ║ Troisième positif : il prouve que la correction n'est pas câblée ║
         ║ sur une dépendance particulière.                                 ║
         ╚══════════════════════════════════════════════════════════════════╝ -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.6</version>
    </dependency>

    <!-- ╔══════════════════════════════════════════════════════════════════╗
         ║ VAL-D04 — REFUS ATTENDU · CROSS_MAJOR_ONLY                       ║
         ║ snakeyaml 1.33 porte CVE-2022-1471, dont la SEULE correction est ║
         ║ la version 2.0 — majeure supérieure.                             ║
         ║ La politique de sélection ne retient qu'une version corrigée de  ║
         ║ MÊME majeure : elle renvoie donc une cible nulle et refuse.      ║
         ║ Le refus ne vient PAS d'une absence de correctif — il en existe  ║
         ║ un — mais du franchissement de majeure, qui exige un humain.     ║
         ╚══════════════════════════════════════════════════════════════════╝ -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>1.33</version>
    </dependency>

    <!-- ╔══════════════════════════════════════════════════════════════════╗
         ║ VAL-D05 — REFUS ATTENDU · TRANSITIVE_NOT_AUTOFIXABLE_V1          ║
         ║ commons-configuration2 2.8.0 entraîne commons-text 1.9 en        ║
         ║ TRANSITIF. commons-text 1.9 porte CVE-2022-42889 « Text4Shell »  ║
         ║ (CRITICAL, CVSS 9.8), corrigée en 1.10.0 — MÊME MAJEURE.         ║
         ║                                                                  ║
         ║ C'est le contre-exemple le plus instructif du projet : la même   ║
         ║ CVE, avec un correctif de même majeure disponible, serait        ║
         ║ auto-corrigée si la dépendance était déclarée en direct. Elle    ║
         ║ est refusée ici uniquement parce qu'elle arrive par transitivité.║
         ║ Le refus porte sur la PROVENANCE, pas sur la disponibilité d'un  ║
         ║ correctif.                                                       ║
         ║                                                                  ║
         ║ L'application n'appelle PAS l'interpolateur vulnérable           ║
         ║ (StringSubstitutor.createInterpolator) : la dépendance est       ║
         ║ présente et réellement utilisée, le chemin exploitable ne l'est  ║
         ║ pas.                                                             ║
         ╚══════════════════════════════════════════════════════════════════╝ -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-configuration2</artifactId>
      <version>2.8.0</version>
    </dependency>

    <!-- ╔════════════════════════════════════════════════════════════════╗
         ║ VAL-D07 — AUTO-CORRIGEABLE · provenance DIRECT_EXPLICIT          ║
         ║ commons-compress 1.21 porte CVE-2024-25710 (boucle infinie) et    ║
         ║ CVE-2024-26308 (épuisement mémoire), corrigées en 1.26.0 — même    ║
         ║ majeure (1.x), donc dans l'enveloppe auto-corrigeable.            ║
         ║ Usage authentique : lecture de l'inventaire d'une archive ZIP      ║
         ║ d'export du référentiel (ArchiveReferentiel).                     ║
         ║ Périmètre de sûreté : lecture d'un flux fourni par le code, jamais ║
         ║ par un appelant ; aucune extraction sur disque, aucun chemin       ║
         ║ d'entrée utilisé pour écrire quoi que ce soit.                     ║
         ╚═════════════════════════════════════════════════════════════════╝ -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.21</version>
    </dependency>

    <!-- ╔═════════════════════════════════════════════════════════════════╗
         ║ VAL-D08 — AUTO-CORRIGEABLE · provenance DIRECT_EXPLICIT          ║
         ║ bcprov-jdk18on 1.72 porte CVE-2023-33201 (fuite d'information via ║
         ║ le CertStore LDAP), corrigée en 1.73 — même majeure (1.x).        ║
         ║ Usage authentique : empreinte SHA-256 d'un contrat, calculée par   ║
         ║ le fournisseur Bouncy Castle (EmpreinteContrat), en miroir du      ║
         ║ contrôle de signature hérité déjà présent.                        ║
         ║ Périmètre de sûreté : aucun CertStore, aucun accès LDAP, aucune    ║
         ║ vérification de chaîne de certificats — le chemin exploitable de  ║
         ║ la CVE n'est pas atteignable dans ce projet.                       ║
         ╚═════════════════════════════════════════════════════════════════╝ -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.72</version>
    </dependency>

    <!-- ╔═════════════════════════════════════════════════════════════════╗
         ║ VAL-D09 — AUTO-CORRIGEABLE · provenance DIRECT_EXPLICIT          ║
         ║ jsoup 1.14.3 porte CVE-2022-36033 (contournement de               ║
         ║ l'assainissement HTML), corrigée en 1.15.3 — même majeure (1.x).  ║
         ║ Usage authentique : échappement des libellés de contrat avant      ║
         ║ insertion dans la page HTML (EtiquetteHtml).                       ║
         ║ Périmètre de sûreté : seul l'échappement d'entités est employé,    ║
         ║ jamais Jsoup.clean() avec une liste blanche — la CVE porte sur le  ║
         ║ contournement de cette dernière, qui n'est pas appelée ici.        ║
         ╚═════════════════════════════════════════════════════════════════╝ -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.14.3</version>
    </dependency>

    <!-- ════════════════════════════════════════════════════════════════════
