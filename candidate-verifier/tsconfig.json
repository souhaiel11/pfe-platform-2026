{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "../",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false
  },
  "include": [
    "src/**/*.ts",
    "../backend/src/candidate-verification/candidate-verification.types.ts",
    "../backend/src/candidate-verification/candidate-digest.ts",
    "../backend/src/context/scope-lock.service.ts"
  ]
}
